# Template only. Configure secrets directly in the separate hosting service.
APP_ENV=production
NODE_ENV=production
SERVE_FRONTEND=true
DATABASE_URL=
# Exact database name from the production database, not its URL.
PRODUCTION_DB_NAME=
# One HTTPS origin, no trailing slash. Use the new service URL until DNS is ready.
FRONTEND_URL=
SESSION_SECRET=
CSRF_SECRET=

# Required only for the first initialization. No account is reset on redeploy.
PRODUCTION_ADMIN_EMAIL=
PRODUCTION_ADMIN_PASSWORD=
PRODUCTION_ADMIN_FIRST_NAME=
PRODUCTION_ADMIN_LAST_NAME=
PRODUCTION_ADMIN_PHONE=

# Closed preparation. Activation requires a later live-payment/email rollout.
ENABLE_STRIPE_CHECKOUT=false
ENABLE_ADMIN_REFUNDS=false
ENABLE_TRANSACTIONAL_NOTIFICATIONS=false
ENABLE_TRANSACTIONAL_SMS=false
ENABLE_CUSTOMER_REGISTRATION=false
SITE_INDEXABLE=false
# Optional canonical HTTPS origin; leave empty to use FRONTEND_URL.
SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
NOTIFICATIONS_START_AT=
TRANSACTIONAL_EMAIL_ALLOWLIST=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sweet-by-andre/production
GOOGLE_ROUTES_API_KEY=
