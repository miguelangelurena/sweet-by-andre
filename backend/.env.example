# Local development connection (DATABASE_URL takes priority when provided).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweet_by_andre_dev
DB_USER=postgres
DB_PASSWORD=

# Railway staging uses its private PostgreSQL DATABASE_URL instead.
# DATABASE_URL=postgresql://user:password@private-host:5432/railway
# APP_ENV=staging
# NODE_ENV=production
# SERVE_FRONTEND=true
# STAGING_ADMIN_EMAIL=sweetbyandre@gmail.com
# STAGING_ADMIN_PASSWORD=choose-a-unique-password-with-at-least-16-characters

FRONTEND_URL=http://localhost:5173
SESSION_SECRET=
CSRF_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_STRIPE_CHECKOUT=false
ENABLE_TRANSACTIONAL_NOTIFICATIONS=false
ENABLE_TRANSACTIONAL_SMS=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Set an explicit ISO timestamp before enabling; older notices are not sent automatically.
NOTIFICATIONS_START_AT=
# Mandatory in staging. Comma-separated test recipient addresses only.
TRANSACTIONAL_EMAIL_ALLOWLIST=
GOOGLE_ROUTES_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Staging uploads automatically use sweet-by-andre/staging.
## Sandbox-only administrative refunds; enable after applying db:refunds.
ENABLE_ADMIN_REFUNDS=false

# Optional local backup tooling. PostgreSQL 18 tools are detected on Windows.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# BACKUP_DIR=path-to-a-private-backup-directory
